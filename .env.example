# Claude API key (https://platform.claude.com)
ANTHROPIC_API_KEY=

# --- Optional: Google Photos. Leave empty to offer camera-roll / device photos only. ---
# Google OAuth client (Google Cloud Console → APIs & Services → Credentials → OAuth client ID, type "Web application")
# Enable the "Google Photos Picker API" on the same project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public base URL of this app, used for the OAuth redirect (no trailing slash).
# Local: http://localhost:3000   Vercel: https://your-app.vercel.app
APP_URL=http://localhost:3000

# 32+ random characters, used to encrypt the session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=

# --- Optional: share videos by text message (all of these are needed) ---
# A passcode you type the first time you share, so strangers can't use your app to send texts.
SHARE_PASSCODE=
# Twilio (https://console.twilio.com): Account SID, Auth Token, and the number texts come from.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# (or use a Messaging Service instead of a single number)
# TWILIO_MESSAGING_SERVICE_SID=
# Storage. On Vercel these are filled in for you when you add the integrations:
#   Storage → Create → Blob          → BLOB_READ_WRITE_TOKEN
#   Storage → Create → Upstash Redis → KV_REST_API_URL, KV_REST_API_TOKEN
BLOB_READ_WRITE_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=
# APP_URL (above) must be set to your public URL; it's used in the texted link and to verify Twilio.
# Local testing without Vercel storage: REELBOT_DEV_STORE=memory (single process only, wiped on restart).
